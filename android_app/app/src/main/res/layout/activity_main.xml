<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrollable main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- Header Row: SWIFT + Gear / Version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tvMainBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="S W I F T"
                    android:textSize="14sp"
                    android:letterSpacing="0.25"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btnQuickSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙"
                    android:textSize="18sp"
                    android:padding="6dp"
                    android:background="?android:selectableItemBackground" />
            </LinearLayout>

            <!-- SPI Score section -->
            <TextView
                android:id="@+id/tvSpiLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPI AI"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvSpiScore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:text="83%"
                    android:textSize="56sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvCallsAnalysed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CALLS ANALYSED"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvLearnedContext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LEARNED CONTEXT"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvGettingSmarter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GETTING SMARTER"
                        android:textSize="9sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Minimal Progress Bar representation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:id="@+id/progressTrack">
                    <View
                        android:id="@+id/progressBarActive"
                        android:layout_width="160dp"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="83%"
                    android:textSize="10sp"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:id="@+id/div1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp" />

            <!-- RECENT CALLS header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvRecentCallsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT CALLS"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btnViewAllCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIEW ALL  →"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:padding="4dp"
                    android:background="?android:selectableItemBackground" />
            </LinearLayout>

            <!-- Container for 4-5 recent calls -->
            <LinearLayout
                android:id="@+id/llRecentCallsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- SPI INSIGHT TODAY banner card -->
            <LinearLayout
                android:id="@+id/cardSpiInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginBottom="28dp"
                android:background="?android:selectableItemBackground">

                <TextView
                    android:id="@+id/tvInsightIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvInsightTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPI INSIGHT · TODAY"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvInsightText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% of analyzed voice calls were authentic human interactions."
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInsightArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→"
                    android:textSize="16sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- PERMISSIONS Section -->
            <TextView
                android:id="@+id/tvSectionPerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTECTION STATUS"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <!-- Row 1: Overlay -->
            <LinearLayout
                android:id="@+id/rowOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?android:selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOverlayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Over Apps"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvOverlaySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floating in-call detection HUD"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRANT →"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:id="@+id/divOverlay"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <!-- Row 2: Accessibility -->
            <LinearLayout
                android:id="@+id/rowAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="?android:selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAccessibilityTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Merge Calls"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvAccessibilitySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero-touch conference bridge dialer"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GRANT →"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:id="@+id/divAccessibility"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp" />

            <!-- DIAGNOSTICS button -->
            <FrameLayout
                android:id="@+id/btnTestPopup"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:foreground="?android:selectableItemBackground">

                <LinearLayout
                    android:id="@+id/btnTestInner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:id="@+id/tvBtnTestText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TEST IN-CALL HUD"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvBtnTestArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvStatusNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="SWIFT Guard monitors every call automatically."
                android:textSize="11sp"
                android:letterSpacing="0.05" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Tab Bar -->
    <LinearLayout
        android:id="@+id/bottomBarMain"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:elevation="8dp">

        <View
            android:id="@+id/divBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:selectableItemBackground">

                <View
                    android:id="@+id/dotHome"
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <TextView
                    android:id="@+id/tvTabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOME"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabInsights"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:selectableItemBackground">

                <View
                    android:id="@+id/dotInsights"
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <TextView
                    android:id="@+id/tvTabInsights"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSIGHTS"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?android:selectableItemBackground">

                <View
                    android:id="@+id/dotSettings"
                    android:layout_width="8dp"
                    android:layout_height="8dp" />

                <TextView
                    android:id="@+id/tvTabSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
