# SWIFT Environment Configuration
# Copy this file to .env and fill in your credentials

# Twilio Credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# SWIFT Server Public URL (used to generate webhook URLs for Twilio)
# Use ngrok for development: ngrok http 8001
# Use your production domain for deployment
SWIFT_PUBLIC_URL=https://your-ngrok-or-domain.ngrok-free.app

# Firebase Cloud Messaging (for push notifications when WebSocket drops)
# Optional - leave blank to disable FCM fallback
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Inference settings
SPI_THREAT_THRESHOLD=0.70
SPI_ELEVATED_THRESHOLD=0.30
INFERENCE_HOP_MS=500
BUFFER_DURATION_S=2.0
