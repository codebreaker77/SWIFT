<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0E17"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ SWIFT Guard"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Real-Time Telephony Deepfake Forensics\nBackground In-Call Scanner"
        android:textColor="#A0A0C0"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnOverlayPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:backgroundTint="#F59E0B"
        android:padding="14dp"
        android:text="1. Grant Display Over Other Apps"
        android:textColor="#000000"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnTestPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#6C5CE7"
        android:padding="14dp"
        android:text="2. Test In-Call Floating HUD"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="When a call arrives on your Samsung/Google phone,\nthe SWIFT bubble will appear automatically."
        android:textColor="#64748B"
        android:textSize="12sp" />

</LinearLayout>
