<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background fills screen -->
    <ImageView
        android:id="@+id/imgSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="SWIFT background" />

    <!-- Top bar: S W I F T + v0.1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="52dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="S W I F T"
            android:id="@+id/tvSplashBrand"
            android:textSize="13sp"
            android:letterSpacing="0.25"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvSplashVersion"
            android:text="v0.1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right side small-caps labels (vertically stacked, right-aligned) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:orientation="vertical"
        android:paddingEnd="28dp"
        android:gravity="end">

        <TextView
            android:id="@+id/tvCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPTURE"
            android:textSize="9sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/tvSummarise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUMMARISE"
            android:textSize="9sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/tvOrganise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORGANISE"
            android:textSize="9sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/tvWithAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WITH AI"
            android:textSize="9sp"
            android:letterSpacing="0.15" />
    </LinearLayout>

    <!-- Bottom content block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="48dp">

        <!-- Headline -->
        <TextView
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smarter\nCalls.\nClearer\nDays."
            android:textSize="44sp"
            android:lineSpacingMultiplier="1.05"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <!-- Sub tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR AI CALL ASSISTANT"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="40dp" />

        <!-- Divider line + GET STARTED row -->
        <View
            android:id="@+id/divSplash"
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnGetStarted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GET STARTED  →"
                android:textSize="13sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:background="?android:selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <!-- Venetian Blinds overlay — initially invisible, covers full screen -->
    <com.swift.guard.VenetianBlindsView
        android:id="@+id/venetianView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

</FrameLayout>
